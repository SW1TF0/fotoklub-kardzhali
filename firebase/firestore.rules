rules_version = '2';

// ============================================================================
// Firestore security rules — Фото Клуб Кърджали
// ----------------------------------------------------------------------------
// Collections:
//   photos   { title, url, storagePath, createdAt }   — public gallery
//   news     { title, content, createdAt }            — public news feed
//   stories  { title, content, createdAt }            — public stories feed
//   users    { uid, name, email, createdAt }           — one doc per registered
//                                                        member, doc id = uid
//   messages { name, email, message, createdAt }      — contact form submissions,
//                                                        write-only for the public,
//                                                        readable only by admins
//
// Admin check supports EITHER strategy described in js/firebase-config.js:
//   1) email allowlist (isAdminEmail) — simplest, matches ADMIN_EMAILS in code
//   2) custom claim `admin: true` set via the Admin SDK / a Cloud Function
//      (isAdminClaim) — recommended for production
// A write is allowed if the caller satisfies EITHER check.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAdminEmail() {
      // Keep this list in sync with ADMIN_EMAILS in js/firebase-config.js
      return isSignedIn() && request.auth.token.email in [
        "krasimiruzun@smartmenukj.com"
      ];
    }

    function isAdmin() {
      return isAdminClaim() || isAdminEmail();
    }

    // Public content: anyone can read, only admins can write.
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: a member can create/read/update only their own profile doc
    // (created at registration, doc id === auth uid). Admins can read all
    // (needed for the "Регистрации" module) but never write another
    // member's document.
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Contact form submissions: anyone can submit (create-only, no read/update
    // so a submitter can never browse other people's messages); only admins
    // can read or delete them (the "Съобщения" tab in admin.html).
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(["name", "email", "message"])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
